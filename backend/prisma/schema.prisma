// ─── Prisma Schema for Orchid Retail Platform ───────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  images       String[]  // Array of image URLs
  tags         String[]  // Tags for filtering
  exportBadge  Boolean   @default(false)
  isFeatured   Boolean   @default(false)
  isActive     Boolean   @default(true)
  variants     Variant[]
  reviews      Review[]
  orderItems   OrderItem[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isActive])
}

// ─── Variant ─────────────────────────────────────────────────────────────────

model Variant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String      @unique
  size          String
  color         String
  colorHex      String?
  price         Float       // Selling price
  mrp           Float       // Max retail price
  stock         Int         @default(0)
  reservedStock Int         @default(0)
  isActive      Boolean     @default(true)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([stock])
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  password  String?   // Hashed, null for social login
  role      String    @default("customer") // "admin" | "customer"
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  userId                 String
  user                   User        @relation(fields: [userId], references: [id])
  items                  OrderItem[]

  subtotal               Float
  discount               Float       @default(0)
  deliveryCharge         Float       @default(0)
  total                  Float

  couponId               String?
  couponCode             String?

  orderStatus            String      @default("pending")
  paymentStatus          String      @default("pending")
  paymentMethod          String?

  // PhonePe
  merchantTransactionId  String?     @unique
  gatewayTransactionId   String?

  // Stock tracking
  stockReserved          Boolean     @default(false)
  stockDeducted          Boolean     @default(false)

  // Shipping
  shippingAddressId      String
  shippingAddress        Address     @relation(fields: [shippingAddressId], references: [id])
  trackingNumber         String?
  courierName            String?

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([merchantTransactionId])
}

// ─── Order Item ──────────────────────────────────────────────────────────────

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id])
  productName  String
  productImage String
  variantSize  String
  variantColor String
  sku          String
  price        Float
  mrp          Float
  quantity     Int
  lineTotal    Float

  @@index([orderId])
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Int      // 1-5
  comment    String
  images     String[]
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

// ─── Coupon ──────────────────────────────────────────────────────────────────

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // "flat" | "percentage"
  value       Float
  minOrder    Float?
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int      @default(0)
  validFrom   DateTime
  validUntil  DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
